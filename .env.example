# Telegram (via @BotFather). Laisser TG_CHAT_ID vide au premier lancement : le bot te donne ton chat id.
TG_TOKEN=
TG_CHAT_ID=

# Mode observation par défaut : rien n'est envoyé tant que les flags sont à false.
SAVE_ARMED=false
COLLECT_ENABLED=false
# Expédition permanente (/autoexplo on) : toujours EXPLO_AUTO_COUNT expéditions opti en vol (10 éclaireurs + 100 GT chacune), durée en heures
EXPLO_AUTO=false
EXPLO_AUTO_HOURS=6
EXPLO_AUTO_COUNT=2
# AUTOBUILD_ENABLED : plus d'interrupteur global, activation par planète (build-plan.json)
# Deut → Père (/autodeut on) : le deut au-dessus de DEUT_CAP sur chaque colonie repart vers Père (rien en dessous de DEUT_COLLECT_MIN d'excédent)
DEUT_COLLECT_ENABLED=false
DEUT_CAP=150000
# DEUT_COLLECT_MIN=25000 (défaut : TRANSPORT_MIN_LOAD)
# Ravitaillement auto : pas de flag non plus, activation par colonie via /autosupply <planète> on (supply.json)
# Financement des bâtiments des colonies par Père (/autobuild finance on|off) et Graviton auto (/autobuild graviton on|off) :
# pas de variable, réglages dans build-plan.json, allumés par défaut.
# Flotte auto (/autofleet, auto-fleet.json, les 5 planètes activées par défaut) : une décision toutes les AUTOFLEET_EVERY_MIN min,
# lots d'environ AUTOFLEET_LOT_H h de chantier, rien sous AUTOFLEET_MIN_LOT_MIN min de chantier (sauf si le max visé le limite)
AUTOFLEET_EVERY_MIN=5
AUTOFLEET_LOT_H=2
AUTOFLEET_MIN_LOT_MIN=30
# Cargaison minimale d'un transport automatique (financement, flotte auto hors Père, autosupply, deut → Père) : un GT plein par défaut,
# le carburant d'un voyage ne vaut pas moins. DEUT_COLLECT_MIN et SUPPLY_MIN_SEND la reprennent s'ils ne sont pas définis.
TRANSPORT_MIN_LOAD=25000

# Ravitaillement auto (/autosupply <planète> on) : chaque colonie active est complétée depuis Père jusqu'à ces stocks, au millier près,
# une vérification toutes les SUPPLY_EVERY_H heures par colonie
SUPPLY_TARGET_METAL=500000
SUPPLY_TARGET_CRYSTAL=350000
SUPPLY_TARGET_DEUT=150000
# SUPPLY_MIN_SEND=25000 (défaut : TRANSPORT_MIN_LOAD)
SUPPLY_EVERY_H=12

# Heartbeat Telegram (heures)
HEARTBEAT_H=6

# Fichier du refresh token Keycloak (chmod 600)
REFRESH_FILE=./refresh_token.txt

# Boucle (ms) — pas de poll rapide
POLL_MS=10000
SAVE_BEFORE_MS=10000
RECALL_AFTER_MS=1500

# Scans / expéditions
SCAN_PROBES=15
EXPLO_DEUT_KEEP=80000

# Veille pirates (ms)
PIRATE_CHECK_MS=300000

# Discord (notifications pirates uniquement) : URL du webhook du salon, vide = désactivé
DISCORD_WEBHOOK_URL=

# Récupération auto (débris / cargaisons)
RECYCLE_ENABLED=false
RECUP_ENABLED=false
SALVAGE_CHECK_MS=600000
DEBRIS_MIN=40000
RECYCLERS_PER_FIELD=2
RECUP_SMALL_CARGO=0
RECUP_MARGIN=1
RECUP_MAX_PATHFINDER=50

# Planète hub : départ des raids, scans, expéditions et ravitaillements (id lu dans /api/state)
HOME_PLANET=pl_2w
