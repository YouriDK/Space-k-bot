# Telegram (via @BotFather). Laisser TG_CHAT_ID vide au premier lancement : le bot te donne ton chat id.
TG_TOKEN=
TG_CHAT_ID=

# Mode observation par défaut : rien n'est envoyé tant que les flags sont à false.
SAVE_ARMED=false
SUPPLY_ENABLED=false
COLLECT_ENABLED=false
# AUTOBUILD_ENABLED : plus d'interrupteur global, activation par planète (build-plan.json)

# Heartbeat Telegram (heures)
HEARTBEAT_H=6

# Fichier du refresh token Keycloak (chmod 600)
REFRESH_FILE=./refresh_token.txt

# Boucle (ms) — pas de poll rapide
POLL_MS=10000
SAVE_BEFORE_MS=10000
RECALL_AFTER_MS=1500

# Scans / expéditions
SCAN_PROBES=15
EXPLO_DEUT_KEEP=80000

# Veille pirates (ms)
PIRATE_CHECK_MS=300000

# Discord (notifications pirates uniquement) : URL du webhook du salon, vide = désactivé
DISCORD_WEBHOOK_URL=

# Récupération auto (débris / cargaisons)
RECYCLE_ENABLED=false
RECUP_ENABLED=false
SALVAGE_CHECK_MS=600000
DEBRIS_MIN=40000
RECYCLERS_PER_FIELD=2
RECUP_SMALL_CARGO=15
RECUP_HEAVY_FIGHTER=10
